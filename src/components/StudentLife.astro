---
import Section from "./Section.astro";
import type { StudentLifeEntry, StudentLifeProps } from "@types";

interface Props {
  entries?: StudentLifeEntry[];
}

const { entries } = Astro.props as Props;
---

<Section text="Student Life" href="student-life">
  {Array.isArray(entries) && entries.length ? (
    <div class="grid grid-cols-1 gap-6">
      {entries.map(({ title, role, summary, highlights, collaborators, media, links }) => (
        <article class="rounded-2xl border border-neutral/20 bg-black p-5">
          <header class="mb-3">
            <h3 class="font-serif text-2xl font-semibold text-white">{title}</h3>
            <p class="text-sm text-white/70">{role}</p>
          </header>

          {collaborators?.length ? (
            <div class="mb-4 flex flex-wrap gap-2">
              {collaborators.map((c) => (
                <span class="rounded-full border border-neutral/30 px-2 py-1 text-xs text-neutral">{c}</span>
              ))}
            </div>
          ) : null}

          {highlights?.length ? (
            <ul class="mt-1 list-none">
              {highlights.map((h) => (
                <li class="relative mb-3 pl-8 text-base text-neutral before:absolute before:top-1 before:left-0 before:content-[url(/check.svg)]">
                  {h}
                </li>
              ))}
            </ul>
          ) : null}

          {summary ? (
            <details class="group mt-2">
              <summary class="cursor-pointer list-none text-sm font-medium text-primary">
                Read more
              </summary>
              <div class="mt-3 space-y-3">
                {summary
                  .split("\n\n")
                  .map((paragraph) => (
                    <p class="text-base text-neutral">{paragraph}</p>
                  ))}
              </div>
            </details>
          ) : null}

          {(links?.length || media?.length) ? (
            <div class="mt-4 flex flex-wrap gap-4 text-white">
              {links?.map((l) => (
                <a href={l.href} target="_blank" class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline">
                  {l.text}
                </a>
              ))}
              {media?.map((m) => (
                m.type === "link" ? (
                  <a href={m.src} target="_blank" class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline">
                    {m.alt || "Media"}
                  </a>
                ) : null
              ))}
            </div>
          ) : null}
        </article>
      ))}
    </div>
  ) : null}
</Section>


